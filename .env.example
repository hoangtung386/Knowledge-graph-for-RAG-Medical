# =============================================================================
# PJI-RAG Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- LLM Provider: "huggingface" (free) or "openai" (paid) ---
LLM_PROVIDER=huggingface

# --- HuggingFace (get token at https://huggingface.co/settings/tokens) ---
HF_TOKEN=hf_your-token-here
HF_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# Optional: stronger model for query generation (leave empty to use HF_LLM_MODEL)
HF_LLM_MODEL_QUERY=

# --- Jina AI: Embedding + Reranker (get key at https://jina.ai/) ---
# If set, Jina embedding replaces HF embedding, and reranker is enabled
JINA_API_KEY=jina_your-api-key-here
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
JINA_EMBEDDING_DIM=1024
JINA_RERANKER_MODEL=jina-reranker-v3

# --- HuggingFace Embedding (fallback when no JINA_API_KEY) ---
# HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# HF_EMBEDDING_DIM=384
# HF_EMBEDDING_BATCH_SIZE=32

# --- OpenAI (if LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-your-key-here
# LLM_MODEL_INDEXING=gpt-4o-mini
# LLM_MODEL_QUERY=gpt-4o

# --- System ---
RAG_WORKING_DIR=./rag_storage
API_HOST=0.0.0.0
API_PORT=8000
